<?xml version="1.0"?>
<!--
  Kho hang 12 x 8 m (x: -6..6, y: -4..4):
  - 4 day ke (moi day 2 ke dai 3 m), loi di chinh doc truc x rong 1 m, loi di ngang giua x = 0.3..1.3
  - Khu xuat hang ben phai co 2 pallet
  - Xe xuat phat o khu trong ben trai (x = -4.5)
-->
<sdf version="1.9">
  <world name="warehouse">
    <physics name="1ms" type="ignored">
      <max_step_size>0.001</max_step_size>
      <real_time_factor>1.0</real_time_factor>
    </physics>

    <plugin filename="gz-sim-physics-system" name="gz::sim::systems::Physics"/>
    <plugin filename="gz-sim-user-commands-system" name="gz::sim::systems::UserCommands"/>
    <plugin filename="gz-sim-scene-broadcaster-system" name="gz::sim::systems::SceneBroadcaster"/>
    <!-- Can cho gpu_lidar -->
    <plugin filename="gz-sim-sensors-system" name="gz::sim::systems::Sensors">
      <render_engine>ogre2</render_engine>
    </plugin>
    <plugin filename="gz-sim-imu-system" name="gz::sim::systems::Imu"/>

    <scene>
      <ambient>0.6 0.6 0.6 1</ambient>
      <background>0.7 0.7 0.7 1</background>
      <grid>false</grid>
    </scene>

    <light type="directional" name="sun">
      <cast_shadows>true</cast_shadows>
      <pose>0 0 10 0 0 0</pose>
      <diffuse>0.9 0.9 0.9 1</diffuse>
      <specular>0.2 0.2 0.2 1</specular>
      <direction>-0.3 0.2 -0.9</direction>
    </light>

    <!-- ===================== San ===================== -->
    <model name="floor">
      <static>true</static>
      <link name="link">
        <collision name="collision">
          <geometry><plane><normal>0 0 1</normal><size>30 30</size></plane></geometry>
        </collision>
        <visual name="visual">
          <geometry><plane><normal>0 0 1</normal><size>30 30</size></plane></geometry>
          <material>
            <ambient>0.55 0.55 0.5 1</ambient>
            <diffuse>0.55 0.55 0.5 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <!-- ===================== Tuong (cao 1 m, day 0.1 m) ===================== -->
    <model name="wall_north">
      <static>true</static>
      <pose>0 4.05 0.5 0 0 0</pose>
      <link name="link">
        <collision name="c"><geometry><box><size>12.2 0.1 1.0</size></box></geometry></collision>
        <visual name="v"><geometry><box><size>12.2 0.1 1.0</size></box></geometry>
          <material><ambient>0.8 0.8 0.8 1</ambient><diffuse>0.8 0.8 0.8 1</diffuse></material></visual>
      </link>
    </model>
    <model name="wall_south">
      <static>true</static>
      <pose>0 -4.05 0.5 0 0 0</pose>
      <link name="link">
        <collision name="c"><geometry><box><size>12.2 0.1 1.0</size></box></geometry></collision>
        <visual name="v"><geometry><box><size>12.2 0.1 1.0</size></box></geometry>
          <material><ambient>0.8 0.8 0.8 1</ambient><diffuse>0.8 0.8 0.8 1</diffuse></material></visual>
      </link>
    </model>
    <model name="wall_east">
      <static>true</static>
      <pose>6.05 0 0.5 0 0 0</pose>
      <link name="link">
        <collision name="c"><geometry><box><size>0.1 8.0 1.0</size></box></geometry></collision>
        <visual name="v"><geometry><box><size>0.1 8.0 1.0</size></box></geometry>
          <material><ambient>0.8 0.8 0.8 1</ambient><diffuse>0.8 0.8 0.8 1</diffuse></material></visual>
      </link>
    </model>
    <model name="wall_west">
      <static>true</static>
      <pose>-6.05 0 0.5 0 0 0</pose>
      <link name="link">
        <collision name="c"><geometry><box><size>0.1 8.0 1.0</size></box></geometry></collision>
        <visual name="v"><geometry><box><size>0.1 8.0 1.0</size></box></geometry>
          <material><ambient>0.8 0.8 0.8 1</ambient><diffuse>0.8 0.8 0.8 1</diffuse></material></visual>
      </link>
    </model>

    <!-- ===================== Ke hang 3.0 x 0.6 x 1.2 m ===================== -->
    <model name="shelf_a1">
      <static>true</static>
      <pose>-1.2 2.4 0.6 0 0 0</pose>
      <link name="link">
        <collision name="c"><geometry><box><size>3.0 0.6 1.2</size></box></geometry></collision>
        <visual name="v"><geometry><box><size>3.0 0.6 1.2</size></box></geometry>
          <material><ambient>0.1 0.3 0.7 1</ambient><diffuse>0.1 0.3 0.7 1</diffuse></material></visual>
      </link>
    </model>
    <model name="shelf_a2">
      <static>true</static>
      <pose>2.8 2.4 0.6 0 0 0</pose>
      <link name="link">
        <collision name="c"><geometry><box><size>3.0 0.6 1.2</size></box></geometry></collision>
        <visual name="v"><geometry><box><size>3.0 0.6 1.2</size></box></geometry>
          <material><ambient>0.1 0.3 0.7 1</ambient><diffuse>0.1 0.3 0.7 1</diffuse></material></visual>
      </link>
    </model>
    <model name="shelf_b1">
      <static>true</static>
      <pose>-1.2 0.8 0.6 0 0 0</pose>
      <link name="link">
        <collision name="c"><geometry><box><size>3.0 0.6 1.2</size></box></geometry></collision>
        <visual name="v"><geometry><box><size>3.0 0.6 1.2</size></box></geometry>
          <material><ambient>0.1 0.3 0.7 1</ambient><diffuse>0.1 0.3 0.7 1</diffuse></material></visual>
      </link>
    </model>
    <model name="shelf_b2">
      <static>true</static>
      <pose>2.8 0.8 0.6 0 0 0</pose>
      <link name="link">
        <collision name="c"><geometry><box><size>3.0 0.6 1.2</size></box></geometry></collision>
        <visual name="v"><geometry><box><size>3.0 0.6 1.2</size></box></geometry>
          <material><ambient>0.1 0.3 0.7 1</ambient><diffuse>0.1 0.3 0.7 1</diffuse></material></visual>
      </link>
    </model>
    <model name="shelf_c1">
      <static>true</static>
      <pose>-1.2 -0.8 0.6 0 0 0</pose>
      <link name="link">
        <collision name="c"><geometry><box><size>3.0 0.6 1.2</size></box></geometry></collision>
        <visual name="v"><geometry><box><size>3.0 0.6 1.2</size></box></geometry>
          <material><ambient>0.1 0.3 0.7 1</ambient><diffuse>0.1 0.3 0.7 1</diffuse></material></visual>
      </link>
    </model>
    <model name="shelf_c2">
      <static>true</static>
      <pose>2.8 -0.8 0.6 0 0 0</pose>
      <link name="link">
        <collision name="c"><geometry><box><size>3.0 0.6 1.2</size></box></geometry></collision>
        <visual name="v"><geometry><box><size>3.0 0.6 1.2</size></box></geometry>
          <material><ambient>0.1 0.3 0.7 1</ambient><diffuse>0.1 0.3 0.7 1</diffuse></material></visual>
      </link>
    </model>
    <model name="shelf_d1">
      <static>true</static>
      <pose>-1.2 -2.4 0.6 0 0 0</pose>
      <link name="link">
        <collision name="c"><geometry><box><size>3.0 0.6 1.2</size></box></geometry></collision>
        <visual name="v"><geometry><box><size>3.0 0.6 1.2</size></box></geometry>
          <material><ambient>0.1 0.3 0.7 1</ambient><diffuse>0.1 0.3 0.7 1</diffuse></material></visual>
      </link>
    </model>
    <model name="shelf_d2">
      <static>true</static>
      <pose>2.8 -2.4 0.6 0 0 0</pose>
      <link name="link">
        <collision name="c"><geometry><box><size>3.0 0.6 1.2</size></box></geometry></collision>
        <visual name="v"><geometry><box><size>3.0 0.6 1.2</size></box></geometry>
          <material><ambient>0.1 0.3 0.7 1</ambient><diffuse>0.1 0.3 0.7 1</diffuse></material></visual>
      </link>
    </model>

    <!-- ===================== Pallet khu xuat hang 1.0 x 0.8 x 0.15 m ===================== -->
    <model name="pallet_1">
      <static>true</static>
      <pose>5.0 2.8 0.075 0 0 0</pose>
      <link name="link">
        <collision name="c"><geometry><box><size>1.0 0.8 0.15</size></box></geometry></collision>
        <visual name="v"><geometry><box><size>1.0 0.8 0.15</size></box></geometry>
          <material><ambient>0.6 0.4 0.2 1</ambient><diffuse>0.6 0.4 0.2 1</diffuse></material></visual>
      </link>
    </model>
    <model name="pallet_2">
      <static>true</static>
      <pose>5.0 -2.8 0.075 0 0 0</pose>
      <link name="link">
        <collision name="c"><geometry><box><size>1.0 0.8 0.15</size></box></geometry></collision>
        <visual name="v"><geometry><box><size>1.0 0.8 0.15</size></box></geometry>
          <material><ambient>0.6 0.4 0.2 1</ambient><diffuse>0.6 0.4 0.2 1</diffuse></material></visual>
      </link>
    </model>

  </world>
</sdf>
