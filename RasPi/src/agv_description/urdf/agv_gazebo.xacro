<?xml version="1.0"?>
<!--
  Phan rieng cho Gazebo Harmonic: ma sat banh, plugin lai xe, lidar, IMU.
  Topic Gazebo dat trung ten topic ROS de bridge 1-1: /cmd_vel, /odom, /tf, /joint_states, /scan, /imu.
-->
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">

  <!-- Ma sat banh cao su tren san kho -->
  <xacro:macro name="wheel_friction" params="prefix">
    <gazebo reference="wheel_${prefix}_link">
      <mu1>1.0</mu1>
      <mu2>1.0</mu2>
    </gazebo>
  </xacro:macro>
  <xacro:wheel_friction prefix="fl"/>
  <xacro:wheel_friction prefix="fr"/>
  <xacro:wheel_friction prefix="rl"/>
  <xacro:wheel_friction prefix="rr"/>

  <!-- Gioi han dong co GA25-370, khop SPD_RPM_MAX trong firmware (STM32/App/Inc/speed_ctrl.h).
       Gioi han theo tung banh (va vung chet SPD_RPM_MIN) do node motor_model lo;
       o day chi la chan tren an toan cho v va w. -->
  <xacro:property name="wheel_rpm_max" value="270"/>
  <xacro:property name="wheel_v_max"   value="${wheel_rpm_max * 2 * pi / 60 * wheel_radius}"/>  <!-- ~0.92 m/s -->

  <gazebo>
    <!-- Skid-steer: DiffDrive nhan nhieu joint moi ben, 2 banh cung ben quay cung toc do.
         Nhan lenh da qua motor_model (/model/agv/cmd_vel), khong nhan thang /cmd_vel. -->
    <plugin filename="gz-sim-diff-drive-system" name="gz::sim::systems::DiffDrive">
      <left_joint>wheel_fl_joint</left_joint>
      <left_joint>wheel_rl_joint</left_joint>
      <right_joint>wheel_fr_joint</right_joint>
      <right_joint>wheel_rr_joint</right_joint>
      <wheel_separation>${effective_track}</wheel_separation>
      <wheel_radius>${wheel_radius}</wheel_radius>
      <max_linear_velocity>${wheel_v_max}</max_linear_velocity>
      <min_linear_velocity>${-wheel_v_max}</min_linear_velocity>
      <max_angular_velocity>${2 * wheel_v_max / effective_track}</max_angular_velocity>
      <min_angular_velocity>${-2 * wheel_v_max / effective_track}</min_angular_velocity>
      <!-- Log buoc 0 -> 120 RPM (khong tai): len ~110 RPM sau 0.25 s, tuc ~1.5 m/s^2.
           Lay 1.0 m/s^2 vi xe co tai se cham hon. -->
      <max_linear_acceleration>1.0</max_linear_acceleration>
      <min_linear_acceleration>-1.0</min_linear_acceleration>
      <max_angular_acceleration>3.0</max_angular_acceleration>
      <min_angular_acceleration>-3.0</min_angular_acceleration>
      <topic>/model/agv/cmd_vel</topic>
      <odom_topic>/odom</odom_topic>
      <tf_topic>/tf</tf_topic>
      <frame_id>odom</frame_id>
      <child_frame_id>base_footprint</child_frame_id>
      <odom_publish_frequency>30</odom_publish_frequency>
    </plugin>

    <plugin filename="gz-sim-joint-state-publisher-system" name="gz::sim::systems::JointStatePublisher">
      <topic>/joint_states</topic>
    </plugin>

  </gazebo>

  <!-- Lidar 2D: thong so gan YDLidar X4 (360 do, ~7 Hz, 0.12-10 m) -->
  <gazebo reference="laser_frame">
    <sensor name="lidar" type="gpu_lidar">
      <gz_frame_id>laser_frame</gz_frame_id>
      <topic>/scan</topic>
      <update_rate>7</update_rate>
      <always_on>true</always_on>
      <visualize>true</visualize>
      <lidar>
        <scan>
          <horizontal>
            <samples>720</samples>
            <resolution>1</resolution>
            <min_angle>-3.14159</min_angle>
            <max_angle>3.14159</max_angle>
          </horizontal>
        </scan>
        <range>
          <min>0.12</min>
          <max>10.0</max>
          <resolution>0.01</resolution>
        </range>
        <noise>
          <type>gaussian</type>
          <mean>0.0</mean>
          <stddev>0.01</stddev>
        </noise>
      </lidar>
    </sensor>
  </gazebo>

  <!-- IMU 100 Hz, nhieu nho gan BNO055 -->
  <gazebo reference="imu_link">
    <sensor name="imu" type="imu">
      <gz_frame_id>imu_link</gz_frame_id>
      <topic>/imu</topic>
      <update_rate>100</update_rate>
      <always_on>true</always_on>
      <imu>
        <angular_velocity>
          <x><noise type="gaussian"><mean>0</mean><stddev>0.002</stddev></noise></x>
          <y><noise type="gaussian"><mean>0</mean><stddev>0.002</stddev></noise></y>
          <z><noise type="gaussian"><mean>0</mean><stddev>0.002</stddev></noise></z>
        </angular_velocity>
        <linear_acceleration>
          <x><noise type="gaussian"><mean>0</mean><stddev>0.02</stddev></noise></x>
          <y><noise type="gaussian"><mean>0</mean><stddev>0.02</stddev></noise></y>
          <z><noise type="gaussian"><mean>0</mean><stddev>0.02</stddev></noise></z>
        </linear_acceleration>
      </imu>
    </sensor>
  </gazebo>

</robot>
