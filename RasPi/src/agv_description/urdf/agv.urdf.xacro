<?xml version="1.0"?>
<!--
  AGV kho hang: xe skid-steer 4 banh (GA25-370 x4), lidar YDLidar X2L, IMU BNO055.
  KICH THUOC VA HINH DANG LAY TU MO HINH CO KHI CAD/agv.FCStd (REPORT.md 4.16, 4.20):
    - so do: bang Params cua file CAD (CAD/export_meshes.py in ra khi chay)
    - hinh hien thi: luoi STL trong meshes/, sinh boi CAD/export_meshes.py. Sua CAD thi chay lai script
      roi sua cac so o day cho khop.
  Than xe 2 tang: 2 tam mica 30 x 30 cm cach nhau 10 cm, 4 tru oc. Banh nam TRONG khung (tang 1 khoet 4 cho).
    - Tang 1: DAU XE la phia PCB + Pi + camera, lidar o phia SAU (= -X cua file CAD, luoi da quay 180 deg), pin treo duoi tang 1, dong co nang NEMA17; 4 vit me T8 noi 2 tang
    - Tang 2: mat nang de chui gam va nang ke mini (kieu Amazon Kiva)
  Lidar nam giua 2 tang, lech ve SAU 0.092 m. 4 tru oc va 4 vit me che vai do -> payload_manager loc bo.
  Va cham (collision) van la hinh hop / tru don gian.
  Frame: base_footprint (mat dat) -> base_link (tam truc banh) -> banh, laser_frame, imu_link,
         lift_plate (khop truot lift_joint, 0 = ha, lift_stroke = nang).
  Gia tri co danh dau (*) la uoc luong - do xe that roi sua.
-->
<robot xmlns:xacro="http://www.ros.org/wiki/xacro" name="agv">

  <!-- ===================== Kich thuoc (m, kg) - theo CAD ===================== -->
  <!-- Mica -->
  <xacro:property name="plate_size"       value="0.30"/>   <!-- 30 x 30 cm -->
  <xacro:property name="plate_thickness"  value="0.005"/>  <!-- (*) -->
  <xacro:property name="plate_gap"        value="0.10"/>   <!-- mat tren tang 1 -> mat duoi tang 2 -->
  <xacro:property name="plate1_below_axle" value="0.0175"/> <!-- (*) theo ga chu L cua GA25: mat duoi tang 1 cao hon truc banh -->
  <xacro:property name="body_mass"        value="2.6"/>    <!-- (*) ca xe tru banh va mat nang: 2 mica ~1.0, 5 dong co ~0.7, pin, mach, lidar -->

  <!-- Banh "65 mm": duong kinh ngoai thuc 68 mm (model banh) -->
  <xacro:property name="wheel_radius"     value="0.034"/>
  <xacro:property name="wheel_width"      value="0.027"/>
  <xacro:property name="wheel_mass"       value="0.08"/>   <!-- (*) -->
  <xacro:property name="wheelbase"        value="0.20"/>   <!-- (*) truc truoc -> truc sau -->
  <xacro:property name="track_width"      value="0.27"/>   <!-- tam banh trai -> tam banh phai, banh nam trong khung 0.30 m -->
  <!-- Skid-steer truot ngang khi quay nen xe quay it hon tinh toan theo track_width.
       Track hieu dung dung cho DiffDrive: cho xe quay tai cho, lay
       effective_track moi = effective_track cu * goc_odom / goc_that. -->
  <xacro:property name="effective_track"  value="0.383"/>  <!-- hieu chinh trong sim: quay tai cho 2.5 rad/s, odom 2.49 / that 2.32 rad/s voi track 0.357 -->

  <!-- Lidar YDLidar X2L (STEP GrabCAD: de 101 x 57 x 11 mm, dau quay D60 x 18 mm, dong co thoi xuong 19.4 mm duoi de),
       day de cach mat tang 1 50 mm (3 tru M3 cai-cai 50), tam dau quay cach tam xe 0.092 m ve phia SAU -->
  <xacro:property name="lidar_x"          value="-0.092"/>
  <xacro:property name="lidar_scan_z"     value="0.1265"/> <!-- (*) so voi mat dat: giua dau quay (phan dung yen cao toi 0.119, dinh 0.1355) -->
  <xacro:property name="lidar_radius"     value="0.030"/>
  <xacro:property name="lidar_body_z0"    value="0.0871"/> <!-- day dong co lidar so voi mat dat -->
  <xacro:property name="lidar_body_z1"    value="0.1355"/>

  <!-- Mat nang tren tang 2 (4 vit me T8 + dai GT2 + NEMA17, tu giu tai khi mat dien) -->
  <xacro:property name="lift_plate_size"  value="0.26"/>
  <xacro:property name="lift_plate_thickness" value="0.01"/>
  <xacro:property name="lift_plate_mass"  value="0.8"/>    <!-- (*) mica 10 mm + 4 dai oc dong -->
  <xacro:property name="lift_gap"         value="0.002"/>  <!-- mat nang ha het cach tang 2 -->
  <xacro:property name="lift_stroke"      value="0.03"/>   <!-- mat nang ha het cao 0.1735 m, ke cao gam 0.18 m: nang ke len ~2.3 cm khoi san -->
  <xacro:property name="lift_speed"       value="0.0067"/> <!-- m/s: vit me T8 buoc 2 mm o 200 vong/phut, ~4.5 s cho het hanh trinh -->

  <!-- Toa do z theo base_link (truc banh) -->
  <xacro:property name="plate1_z"   value="${plate1_below_axle + plate_thickness / 2}"/>
  <xacro:property name="plate1_top" value="${plate1_below_axle + plate_thickness}"/>
  <xacro:property name="plate2_z"   value="${plate1_top + plate_gap + plate_thickness / 2}"/>
  <xacro:property name="plate2_top" value="${plate1_top + plate_gap + plate_thickness}"/>
  <xacro:property name="mesh_dir"   value="file://$(find agv_description)/meshes"/>

  <!-- ===================== Mau ===================== -->
  <material name="mica"><color rgba="0.75 0.88 1.0 0.5"/></material>
  <material name="black"><color rgba="0.08 0.08 0.08 1.0"/></material>
  <material name="grey"><color rgba="0.45 0.47 0.5 1.0"/></material>
  <material name="dark"><color rgba="0.22 0.22 0.25 1.0"/></material>
  <material name="lidar_blue"><color rgba="0.05 0.10 0.75 1.0"/></material>

  <!-- ===================== Macro quan tinh ===================== -->
  <xacro:macro name="box_inertia" params="m x y z *origin">
    <inertial>
      <xacro:insert_block name="origin"/>
      <mass value="${m}"/>
      <inertia ixx="${m * (y*y + z*z) / 12}" ixy="0" ixz="0"
               iyy="${m * (x*x + z*z) / 12}" iyz="0"
               izz="${m * (x*x + y*y) / 12}"/>
    </inertial>
  </xacro:macro>

  <!-- Truc cylinder dat theo z cua link -->
  <xacro:macro name="cylinder_inertia" params="m r h *origin">
    <inertial>
      <xacro:insert_block name="origin"/>
      <mass value="${m}"/>
      <inertia ixx="${m * (3*r*r + h*h) / 12}" ixy="0" ixz="0"
               iyy="${m * (3*r*r + h*h) / 12}" iyz="0"
               izz="${m * r * r / 2}"/>
    </inertial>
  </xacro:macro>

  <!-- ===================== Than xe ===================== -->
  <link name="base_footprint"/>

  <joint name="base_joint" type="fixed">
    <parent link="base_footprint"/>
    <child link="base_link"/>
    <origin xyz="0 0 ${wheel_radius}" rpy="0 0 0"/>
  </joint>

  <link name="base_link">
    <!-- Hinh hien thi tu CAD. Lidar (gpu_lidar) nhin thay cac luoi nay: 4 tru oc, 4 vit me nang -->
    <visual>
      <geometry><mesh filename="${mesh_dir}/base_plates.stl"/></geometry>
      <material name="mica"/>
    </visual>
    <visual>
      <geometry><mesh filename="${mesh_dir}/base_parts.stl"/></geometry>
      <material name="dark"/>
    </visual>
    <visual>
      <geometry><mesh filename="${mesh_dir}/lidar.stl"/></geometry>
      <material name="dark"/>
    </visual>
    <visual>
      <geometry><mesh filename="${mesh_dir}/lidar_head.stl"/></geometry>
      <material name="lidar_blue"/>
    </visual>

    <!-- Va cham: 2 tam mica + than lidar (banh nam trong cho khoet cua tang 1; cung model nen khong tu va cham) -->
    <collision>
      <origin xyz="0 0 ${plate1_z}"/>
      <geometry><box size="${plate_size} ${plate_size} ${plate_thickness}"/></geometry>
    </collision>
    <collision>
      <origin xyz="0 0 ${plate2_z}"/>
      <geometry><box size="${plate_size} ${plate_size} ${plate_thickness}"/></geometry>
    </collision>
    <collision>
      <origin xyz="${lidar_x} 0 ${(lidar_body_z0 + lidar_body_z1) / 2 - wheel_radius}"/>
      <geometry><cylinder radius="${lidar_radius}" length="${lidar_body_z1 - lidar_body_z0}"/></geometry>
    </collision>

    <!-- Khoi luong don o tang 1 (pin, dong co, mach) -> trong tam thap -->
    <xacro:box_inertia m="${body_mass}" x="${plate_size}" y="${plate_size}" z="0.06">
      <origin xyz="0 0 ${plate1_top + 0.02}"/>
    </xacro:box_inertia>
  </link>

  <!-- ===================== Banh xe ===================== -->
  <!-- prefix: fl/fr/rl/rr, x: +truoc/-sau, y: +trai/-phai -->
  <xacro:macro name="wheel" params="prefix x y">
    <link name="wheel_${prefix}_link">
      <!-- luoi banh trai (khop noi quay vao trong); banh phai quay 180 deg -->
      <visual>
        <origin xyz="0 0 0" rpy="0 0 ${0 if y > 0 else pi}"/>
        <geometry><mesh filename="${mesh_dir}/wheel.stl"/></geometry>
        <material name="black"/>
      </visual>
      <collision>
        <origin xyz="0 0 0" rpy="${pi/2} 0 0"/>
        <geometry><cylinder radius="${wheel_radius}" length="${wheel_width}"/></geometry>
      </collision>
      <xacro:cylinder_inertia m="${wheel_mass}" r="${wheel_radius}" h="${wheel_width}">
        <origin xyz="0 0 0" rpy="${pi/2} 0 0"/>
      </xacro:cylinder_inertia>
    </link>

    <joint name="wheel_${prefix}_joint" type="continuous">
      <parent link="base_link"/>
      <child link="wheel_${prefix}_link"/>
      <origin xyz="${x} ${y} 0" rpy="0 0 0"/>
      <axis xyz="0 1 0"/>
    </joint>
  </xacro:macro>

  <xacro:wheel prefix="fl" x="${ wheelbase/2}" y="${ track_width/2}"/>
  <xacro:wheel prefix="fr" x="${ wheelbase/2}" y="${-track_width/2}"/>
  <xacro:wheel prefix="rl" x="${-wheelbase/2}" y="${ track_width/2}"/>
  <xacro:wheel prefix="rr" x="${-wheelbase/2}" y="${-track_width/2}"/>

  <!-- ===================== Lidar (giua 2 tang, phia truoc) ===================== -->
  <!-- Hinh va va cham cua than lidar nam trong base_link; laser_frame chi la goc tia quet -->
  <link name="laser_frame">
    <xacro:cylinder_inertia m="0.01" r="0.01" h="0.01">
      <origin xyz="0 0 0" rpy="0 0 0"/>
    </xacro:cylinder_inertia>
  </link>

  <joint name="laser_joint" type="fixed">
    <parent link="base_link"/>
    <child link="laser_frame"/>
    <origin xyz="${lidar_x} 0 ${lidar_scan_z - wheel_radius}" rpy="0 0 0"/>
  </joint>

  <!-- ===================== Mat nang (tang 2) ===================== -->
  <link name="lift_plate">
    <visual>
      <geometry><mesh filename="${mesh_dir}/lift_plate.stl"/></geometry>
      <material name="grey"/>
    </visual>
    <!-- Ten cho cam bien tiep xuc "co ke": URDF -> SDF them duoi "_collision" thanh
         "lift_plate_collision" (ten dung trong agv_gazebo.xacro) -->
    <collision name="lift_plate">
      <geometry><box size="${lift_plate_size} ${lift_plate_size} ${lift_plate_thickness}"/></geometry>
    </collision>
    <xacro:box_inertia m="${lift_plate_mass}" x="${lift_plate_size}" y="${lift_plate_size}" z="${lift_plate_thickness}">
      <origin xyz="0 0 0"/>
    </xacro:box_inertia>
  </link>

  <joint name="lift_joint" type="prismatic">
    <parent link="base_link"/>
    <child link="lift_plate"/>
    <origin xyz="0 0 ${plate2_top + lift_gap + lift_plate_thickness / 2}" rpy="0 0 0"/>
    <axis xyz="0 0 1"/>
    <limit lower="0.0" upper="${lift_stroke}" effort="300" velocity="${lift_speed}"/>
  </joint>

  <!-- ===================== IMU (BNO055, tang 1) ===================== -->
  <link name="imu_link">
    <xacro:box_inertia m="0.01" x="0.02" y="0.02" z="0.005">
      <origin xyz="0 0 0"/>
    </xacro:box_inertia>
  </link>

  <joint name="imu_joint" type="fixed">
    <parent link="base_link"/>
    <child link="imu_link"/>
    <origin xyz="0 0 ${plate1_top}" rpy="0 0 0"/>
  </joint>

  <!-- Plugin va cam bien cho Gazebo (robot_state_publisher bo qua phan nay) -->
  <xacro:include filename="agv_gazebo.xacro"/>

</robot>
